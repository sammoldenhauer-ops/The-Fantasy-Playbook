# --- Database (Postgres via Neon or Vercel Postgres) ---
# Connection string used by Prisma at runtime.
DATABASE_URL="postgresql://user:password@host:5432/fantasy_vibes?sslmode=require"
# Direct (non-pooled) connection, used for Prisma migrations if your provider pools connections.
DIRECT_URL="postgresql://user:password@host:5432/fantasy_vibes?sslmode=require"

# --- NextAuth ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Google OAuth provider
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# Email (magic link) provider — SMTP connection string, e.g. Resend, Postmark, etc.
AUTH_EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
AUTH_EMAIL_FROM="The Fantasy Playbook <noreply@thefantasyplaybook.com>"

# Comma-separated list of emails allowed to access /admin/* routes
ADMIN_EMAILS="you@example.com"

# --- Stripe (scaffolded only, no active checkout/paywall yet) ---
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
