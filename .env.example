# Copy these keys into the environment-variable settings for your deployment.
# Never commit a real .env file or real credentials to GitHub.

# --- Neon Postgres ---
# Runtime connection: Neon pooled connection string (usually includes
# `-pooler` in the hostname). Copy it from the Neon dashboard's Connect panel.
DATABASE_URL=""
# Migration connection: Neon direct/unpooled connection string.
DIRECT_URL=""

# --- Auth.js / NextAuth ---
# Required everywhere. Generate with: npx auth secret
AUTH_SECRET=""
# Local development URL:
AUTH_URL="http://localhost:3000"
# Vercel URL example: https://your-project.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth credentials from Google Cloud Console.
# Authorized redirect URI:
# https://your-project.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Magic-link email is disabled for now. Add these later when an SMTP provider
# (such as Resend) is configured:
# AUTH_EMAIL_SERVER="smtps://resend:YOUR_RESEND_API_KEY@smtp.resend.com:465"
# AUTH_EMAIL_FROM="The Fantasy Playbook <noreply@your-domain.com>"

# Comma-separated emails allowed to access /admin/* routes.
ADMIN_EMAILS="sam.moldenhauer@gmail.com"

# --- Stripe (scaffold only; no checkout or paywall is active) ---
# Add test-mode values from https://dashboard.stripe.com/test/apikeys later.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
